# QA only. Do not commit real secrets.
APP_ENV=QA_CONTROLLED_TEST_ONLY
MODEL_MODE=deterministic
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=700
QA_DB_PATH=data/qa_sessions.db
SESSION_TTL_SECONDS=86400
MAX_TURNS_PER_SESSION=30
IP_REQUESTS_PER_MINUTE=60
SESSION_REQUESTS_PER_MINUTE=45
QA_EPHEMERAL_REGISTRATION=true
COOKIE_SECURE=false

# Staging/any non-local, non-QA_CONTROLLED_TEST_ONLY APP_ENV is fail-closed:
# both access secrets are mandatory, and COOKIE_SECURE must remain true.
# Never commit real values.
# OPENAI_API_KEY=
# STAGING_ACCESS_USER=
# STAGING_ACCESS_PASSWORD=

# Set MODEL_MODE=gemini and GEMINI_API_KEY to use free-tier natural-language
# chat (Google AI Studio: https://aistudio.google.com/apikey, no credit card).
# Never commit a real key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Required only if you run QA_CONTROLLED_TEST_ONLY somewhere other than a bare
# "python -m uvicorn" process on your own machine (e.g. behind a reverse proxy,
# a container port-forward, a tunnel). Without these, /qa-control/* only
# accepts genuine loopback (127.0.0.1) connections, which a reverse proxy in
# front of the app defeats. Never commit real values.
# QA_CONTROL_USER=
# QA_CONTROL_PASSWORD=

# Only set this to true if the app sits behind a reverse proxy YOU control that
# sets X-Forwarded-For itself (Railway, nginx, etc.). It is false by default
# because that header is otherwise fully client-controlled and would let a
# caller spoof a different IP on every request to dodge per-IP rate limiting.
# TRUST_PROXY_HEADERS=true

# Optional: HMAC key used to sign the session cookie so a client can never pick
# an arbitrary session id. If unset, a random key is generated per process
# (sessions won't survive a restart/redeploy, but cookies still can't be forged).
# SESSION_SECRET=
